solid pyramid
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 20 0
      vertex 20 20 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 20 20 0
      vertex 20 0 0
    endloop
  endfacet
  facet normal 0 -1 0.5
    outer loop
      vertex 0 0 0
      vertex 20 0 0
      vertex 10 10 20
    endloop
  endfacet
  facet normal 1 0 0.5
    outer loop
      vertex 20 0 0
      vertex 20 20 0
      vertex 10 10 20
    endloop
  endfacet
  facet normal 0 1 0.5
    outer loop
      vertex 20 20 0
      vertex 0 20 0
      vertex 10 10 20
    endloop
  endfacet
  facet normal -1 0 0.5
    outer loop
      vertex 0 20 0
      vertex 0 0 0
